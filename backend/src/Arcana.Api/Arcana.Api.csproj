<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="CloudinaryDotNet" Version="1.29.2" />
    <!-- SignalR: real-time push so all players see the same game state
         without each tab polling every 1-2s. The Hub broadcasts
         "room-updated" after every GameService mutation. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arcana.Infrastructure\Arcana.Infrastructure.csproj" />
    <ProjectReference Include="..\Arcana.Application\Arcana.Application.csproj" />
    <ProjectReference Include="..\Arcana.Shared\Arcana.Shared.csproj" />
  </ItemGroup>

</Project>
