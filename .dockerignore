## Keep the Docker build context small - only the backend folder is needed.
frontend/
docs/
img/
scripts/

## .git / GitHub metadata
.git/
.gitignore
.gitattributes

## Editor / OS
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

## Tooling artefacts
*.log
.fake
.vite-preview*.err
.vite-preview*.out
backend/.api.err
backend/.api.out

## Local build output (regenerated inside the image)
backend/artifacts/
backend/coverage/
**/bin/
**/obj/

## Secrets - never bake into the image
Secrets/
firebase-credentials.json
*-firebase-adminsdk-*.json
.env
.env.local
